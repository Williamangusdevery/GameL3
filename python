from card import card #get card template from card.py
from Player import Player

print("Magic cards starting!")

player = Player()
enemy = Player()


#cards
Zap = card("Zap", 1, 1, "enemy", "damage") #Zap test card
Heal = card("Heal", 1, 2, "self", "heal") #add heal card
Guard = card("Guard", 1, 2, "self", "Block") # add guard card 

def play_card(player, card): #playing  cards
    if player.mana < card.mana_cost:
        print("NEED MORE MANA!")
        return

    player.mana = player.mana - card.mana_cost

    if card.action == "damage":
        enemy.hp = enemy.hp - card.amount

    elif card.action == "heal":
        player.hp = min(player.hp + card.amount, player.max_hp)

    elif card.action == "block":
        player.shield = player.shield + card.amount

    print("Played:", card.name)


play_card(player, Zap)

print("Player HP:", player.hp)
print("Player Mana:", player.mana)
print("Player Shield:", player.shield)

print("Enemy HP:", enemy.hp)