from card import card #get card template from card.py

print("Magic cards starting!")

Player_hp = 10 
Enemy_hp = 10
Player_mana = 4 #declearing varibles
Enemy_mana = 4

Zap = card("Zap", 1, 1, "enemy", "damage") #Zap test card


def play_card(card):
    global Player_hp #new function to resolve cards
    global Enemy_hp
    global Player_mana

    if Player_mana < card.mana_cost: #incase not enough mana
        print("NEED MORE MANA")
        return

    Player_mana = Player_mana - card.mana_cost #spend mana

    if card.action == "damage": #deal damage 
        Enemy_hp = Enemy_hp - card.amount 


    print ("played:", card.name)
    print ("Enemy hitpoints:", Enemy_hp) #telling player stuff 
    print("Player HP:", Player_hp)
    print("Mana:", Player_mana)
    

play_card(Zap) #play zap